<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">Stock picking out Split button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="state" position="before">
                <button
                    name="%(stock_split_picking.action_stock_split_picking)s"
                    invisible="state not in ('draft', 'confirmed', 'waiting', 'assigned')"
                    string="Split"
                    groups="stock.group_stock_user"
                    type="action"
                />
            </field>
            <xpath
                expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']"
                position="after"
            >
                <field
                    name="split_manual_quantity"
                    optional="hide"
                    readonly="state in ('done', 'cancel')"
                />
            </xpath>
        </field>
    </record>
</odoo>
