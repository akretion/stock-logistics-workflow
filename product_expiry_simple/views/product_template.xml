<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product_expiry_simple.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form" />
        <field name="arch" type="xml">
            <group name="traceability" position="inside">
                <field
                    name="use_expiry_date"
                    attrs="{'invisible': [('tracking', 'not in', ('lot', 'serial'))]}"
                />
                <label
                    for="default_expiry_delay"
                    attrs="{'invisible': [('use_expiry_date', '=', False)]}"
                />
                <div
                    name="default_expiry_delay"
                    attrs="{'invisible': [('use_expiry_date', '=', False)]}"
                >
                        <field name="default_expiry_delay" class="oe_inline" /> days
                </div>
            </group>
        </field>
    </record>
</odoo>
